// =====================================================================
// Генератор тепла, Delta TP70P (DVP-SS2), ISPSoft, мова IL
// Порядок модулів: 0 Ініціалізація -> 1 Безпека/аварії -> 2 Температура
//                  -> 3 Команди оператора -> 4 Послідовність -> 5 Виходи
// =====================================================================

// ---------- МОДУЛЬ 0: ІНІЦІАЛІЗАЦІЯ (перший цикл після RUN) ----------
LD M1002
AND= D100 K0
MOV K60 D100
LD M1002
AND= D104 K0
MOV K3 D104
LD M1002
AND= D106 K0
MOV K90 D106
LD M1002
ZRST M11 M15
RST M21

// ---------- МОДУЛЬ 1: БЕЗПЕКА ТА АВАРІЇ ----------
// Скидання: лише коли E-Stop відпущена і полум'я немає
LD M102
AND X0
ANI X1
ZRST M51 M59
RST M104
// M51 E-Stop: негайно скинути всі кроки
LDI X0
SET M51
ZRST M11 M15
// M52 Низький тиск газу в будь-якому активному кроці
LD M11
OR M12
OR M13
OR M14
ANI X3
SET M52
// M53 Повітря: підтвердження під час продувки
LD M11
AND X2
SET M30
LD M11
ANI M30
TMR T4 K100
LD T4
SET M53
LD M11
AND M30
ANI X2
SET M53
LD M12
OR M13
OR M14
ANI X2
SET M53
// M54 Паразитне полум'я до розпалу
LD M10
OR M11
OR M12
AND X1
TMR T7 K20
LD T7
SET M54
// M56 Згасання полум'я під час роботи
LD M14
ANI X1
SET M56
// M57 Перегрів
LD>= D102 D106
SET M57
// M58 Залипання реле тиску повітря
LD M10
ANI Y0
AND X2
TMR T6 K50
LD T6
SET M58
// M59 Несправність датчика температури
LD< D102 K0
OR>= D102 K1000
TMR T8 K10
LD T8
SET M59
// M50 Загальна аварія
LD M51
OR M52
OR M53
OR M54
OR M55
OR M56
OR M57
OR M58
OR M59
OUT M50
// M0 Ланцюг безпеки
LD X0
AND X3
ANI M50
OUT M0

// ---------- МОДУЛЬ 2: РЕГУЛЮВАННЯ ТЕМПЕРАТУРИ ----------
LD M1000
ADD D100 D104 D110
SUB D100 D104 D112
LD<= D102 D112
SET M20
LD>= D102 D110
RST M20
// Перевірка уставок: межа вимкнення має бути нижчою за межу перегріву
LD>= D110 D106
OR<= D104 K0
OR<= D100 K0
OUT M60

// ---------- МОДУЛЬ 3: КОМАНДИ ОПЕРАТОРА ----------
LD M100
AND M0
SET M21
LD M101
OR M50
RST M21
LD M103
AND M50
SET M104

// ---------- МОДУЛЬ 4: ПОСЛІДОВНІСТЬ ----------
// M10 Очікування = жоден крок не активний
LDI M11
ANI M12
ANI M13
ANI M14
ANI M15
OUT M10
LD M10
RST M30
// Пуск: повітря і полум'я мають бути відсутні (самоперевірка датчиків)
LD M10
AND M21
AND M20
AND M0
ANI X1
ANI X2
ANI M60
SET M11
// M11 Продувка: таймер іде лише при підтвердженому тиску повітря
LD M11
AND M30
AND X2
TMR T0 K300
LD M11
AND T0
RST M11
SET M12
// M12 Передрозпал
LD M12
TMR T1 K20
LD M12
AND T1
RST M12
SET M13
// M13 Час безпеки: полум'я стабільне 1 с -> робота
LD M13
TMR T2 K30
LD M13
AND X1
TMR T5 K10
LD M13
AND T5
RST M13
SET M14
// Немає полум'я до кінця TSA -> аварія, клапан закривається в цьому ж циклі
LD M13
AND T2
SET M55
ZRST M11 M14
// Стоп оператором або зникнення запиту на тепло -> постпродувка
LD M14
ANI M20
LD M11
OR M12
OR M13
OR M14
ANI M21
ORB
ZRST M11 M14
SET M15
// Аварія -> негайно припинити горіння; постпродувка, якщо E-Stop не натиснута
LDP M50
ZRST M11 M14
LDP M50
AND X0
SET M15
// M15 Постпродувка
LD M15
TMR T3 K300
LD M15
AND T3
RST M15
// Код стану для HMI
LD M10
MOV K0 D150
LD M11
MOV K1 D150
LD M12
MOV K2 D150
LD M13
MOV K3 D150
LD M14
MOV K4 D150
LD M15
MOV K5 D150
LD M50
MOV K9 D150

// ---------- МОДУЛЬ 5: ВИХОДИ (кожна котушка лише один раз) ----------
// Y0 Вентилятор
LD M11
OR M12
OR M13
OR M14
OR M15
AND X0
OUT Y0
// Y1 Трансформатор розпалу
LD M12
OR M13
AND M0
AND Y0
AND X2
OUT Y1
// Y2 Клапан палива: TSA (M13) або робота з полум'ям (M14 * X1),
// а також ОБОВ'ЯЗКОВО: E-Stop OK, газ OK, вентилятор увімкнено, тиск повітря є, немає аварії
LD M13
LD M14
AND X1
ORB
AND M0
AND X0
AND X3
AND Y0
AND X2
ANI M50
OUT Y2
// Y3 Сирена
LD M50
ANI M104
OUT Y3
END
